{
  "entities": {
    "ods_video_raw": {
      "id": "ods_video_raw",
      "name": "ods_video_raw",
      "properties": {
        "type": "table",
        "system": "ods",
        "owner": "content_data"
      },
      "description": "Raw video metadata table",
      "children": []
    },
    "dim_tag_taxonomy": {
      "id": "dim_tag_taxonomy",
      "name": "dim_tag_taxonomy",
      "properties": {
        "type": "table",
        "system": "dim",
        "owner": "content_ops"
      },
      "description": "Tag taxonomy table",
      "children": []
    },
    "job_video_tag_enrich": {
      "id": "job_video_tag_enrich",
      "name": "job_video_tag_enrich",
      "properties": {
        "type": "task",
        "system": "airflow",
        "owner": "algo_platform",
        "schedule": "hourly"
      },
      "description": "Normalize and enrich tags",
      "children": [
        "dwd_video_profile"
      ]
    },
    "dwd_video_profile": {
      "id": "dwd_video_profile",
      "name": "dwd_video_profile",
      "properties": {
        "type": "table",
        "system": "dwd",
        "owner": "content_data"
      },
      "description": "Video profile wide table",
      "children": [
        "rec_feature_store",
        "search_video_index",
        "moderation_rule_engine"
      ]
    },
    "rec_feature_store": {
      "id": "rec_feature_store",
      "name": "rec_feature_store",
      "properties": {
        "type": "feature_view",
        "domain": "recommendation",
        "owner": "rec_team"
      },
      "description": "Recommendation feature view",
      "children": []
    },
    "search_video_index": {
      "id": "search_video_index",
      "name": "search_video_index",
      "properties": {
        "type": "search_index",
        "domain": "search",
        "owner": "search_team"
      },
      "description": "Search index",
      "children": []
    },
    "moderation_rule_engine": {
      "id": "moderation_rule_engine",
      "name": "moderation_rule_engine",
      "properties": {
        "type": "control_service",
        "domain": "moderation",
        "owner": "safety_team"
      },
      "description": "Moderation rule engine",
      "children": []
    }
  },
  "transitions": [
    {
      "id": "tr_ods_to_enrich",
      "source": "ods_video_raw",
      "target": "job_video_tag_enrich",
      "properties": {
        "mode": "read",
        "fields": [
          "video_id",
          "title",
          "tags",
          "creator_id"
        ]
      }
    },
    {
      "id": "tr_dim_to_enrich",
      "source": "dim_tag_taxonomy",
      "target": "job_video_tag_enrich",
      "properties": {
        "mode": "join",
        "fields": [
          "tag_id",
          "normalized_name",
          "parent_tag_id"
        ]
      }
    },
    {
      "id": "tr_enrich_to_profile",
      "source": "job_video_tag_enrich",
      "target": "dwd_video_profile",
      "properties": {
        "mode": "write",
        "logic": "tag_normalize + tag_complete + risk_tag_map"
      }
    },
    {
      "id": "tr_profile_to_feature",
      "source": "dwd_video_profile",
      "target": "rec_feature_store",
      "properties": {
        "mode": "feature_extract",
        "features": [
          "primary_tags",
          "quality_score"
        ]
      }
    },
    {
      "id": "tr_profile_to_search",
      "source": "dwd_video_profile",
      "target": "search_video_index",
      "properties": {
        "mode": "index",
        "fields": [
          "title",
          "primary_tags"
        ]
      }
    },
    {
      "id": "tr_profile_to_moderation",
      "source": "dwd_video_profile",
      "target": "moderation_rule_engine",
      "properties": {
        "mode": "check",
        "signals": [
          "risk_tags",
          "quality_score"
        ]
      }
    }
  ]
}
