    "transitions": [
      {
        "id": "tr_ods_video_to_clean",
        "source": "ods_video_raw",
        "target": "etl_video_clean_job",
        "properties": {
          "mode": "read",
          "fields": [
            "video_id",
            "title",
            "category",
            "creator_id"
          ]
        }
      },
      {
        "id": "tr_dim_tag_to_clean",
        "source": "dim_tag_taxonomy",
        "target": "etl_video_clean_job",
        "properties": {
          "mode": "join",
          "keys": [
            "tag_id"
          ]
        }
      },
      {
        "id": "tr_clean_to_dwd_video",
        "source": "etl_video_clean_job",
        "target": "dwd_video_profile",
        "properties": {
          "mode": "write",
          "logic": "quality_score + normalized_tags"
        }
      },
      {
        "id": "tr_ods_creator_to_agg",
        "source": "ods_creator_raw",
        "target": "etl_creator_aggregate_job",
        "properties": {
          "mode": "read",
          "fields": [
            "creator_id",
            "region",
            "fan_count"
          ]
        }
      },
      {
        "id": "tr_dwd_video_to_agg",
        "source": "dwd_video_profile",
        "target": "etl_creator_aggregate_job",
        "properties": {
          "mode": "aggregate",
          "metrics": [
            "play_cnt",
            "watch_time"
          ]
        }
      },
      {
        "id": "tr_agg_to_dws_creator",
        "source": "etl_creator_aggregate_job",
        "target": "dws_creator_profile",
        "properties": {
          "mode": "write",
          "grain": "creator_id"
        }
      },
      {
        "id": "tr_querylog_to_intent_job",
        "source": "ods_search_query_log",
        "target": "intent_feature_job",
        "properties": {
          "mode": "read",
          "fields": [
            "query",
            "click_doc",
            "session_id"
          ]
        }
      },
      {
        "id": "tr_intent_job_to_intent_feature",
        "source": "intent_feature_job",
        "target": "search_query_intent_feature",
        "properties": {
          "mode": "write",
          "features": [
            "intent_type",
            "query_embedding"
          ]
        }
      },
      {
        "id": "tr_dwd_video_to_feature_job",
        "source": "dwd_video_profile",
        "target": "feature_generate_job",
        "properties": {
          "mode": "read",
          "fields": [
            "video_id",
            "primary_tags",
            "quality_score"
          ]
        }
      },
      {
        "id": "tr_dws_creator_to_feature_job",
        "source": "dws_creator_profile",
        "target": "feature_generate_job",
        "properties": {
          "mode": "join",
          "keys": [
            "creator_id"
          ]
        }
      },
      {
        "id": "tr_feature_job_to_rec_store",
        "source": "feature_generate_job",
        "target": "rec_feature_store",
        "properties": {
          "mode": "write",
          "target_view": "video_rec_features"
        }
      },
      {
        "id": "tr_rec_store_to_rank",
        "source": "rec_feature_store",
        "target": "rec_rank_service",
        "properties": {
          "mode": "serve",
          "latency_ms": 30
        }
      },
      {
        "id": "tr_rank_to_feedback",
        "source": "rec_rank_service",
        "target": "rec_feedback_topic",
        "properties": {
          "mode": "emit",
          "event": "exposure_click_feedback"
        }
      },
      {
        "id": "tr_dwd_video_to_index_job",
        "source": "dwd_video_profile",
        "target": "index_build_job",
        "properties": {
          "mode": "read",
          "fields": [
            "video_id",
            "title",
            "tags"
          ]
        }
      },
      {
        "id": "tr_intent_feature_to_index_job",
        "source": "search_query_intent_feature",
        "target": "index_build_job",
        "properties": {
          "mode": "join",
          "keys": [
            "query_intent_bucket"
          ]
        }
      },
      {
        "id": "tr_index_job_to_search_index",
        "source": "index_build_job",
        "target": "search_video_index",
        "properties": {
          "mode": "write",
          "index_type": "hybrid_ann_bm25"
        }
      },
      {
        "id": "tr_search_index_to_ranking",
        "source": "search_video_index",
        "target": "search_ranking_service",
        "properties": {
          "mode": "serve",
          "latency_ms": 25
        }
      },
      {
        "id": "tr_dwd_video_to_moderation_job",
        "source": "dwd_video_profile",
        "target": "moderation_enrich_job",
        "properties": {
          "mode": "read",
          "signals": [
            "risk_tags",
            "quality_score"
          ]
        }
      },
      {
        "id": "tr_risk_dict_to_moderation_job",
        "source": "risk_label_dict",
        "target": "moderation_enrich_job",
        "properties": {
          "mode": "join",
          "keys": [
            "risk_label"
          ]
        }
      },
      {
        "id": "tr_moderation_job_to_engine",
        "source": "moderation_enrich_job",
        "target": "moderation_rule_engine",
        "properties": {
          "mode": "write",
          "output": "risk_decision_payload"
        }
      },
      {
        "id": "tr_engine_to_audit",
        "source": "moderation_rule_engine",
        "target": "audit_event_log",
        "properties": {
          "mode": "sink",
          "retention": "180d"
        }
      },
      {
        "id": "tr_rec_store_to_ad_targeting",
        "source": "rec_feature_store",
        "target": "ad_targeting_service",
        "properties": {
          "mode": "feature_feed",
          "fields": [
            "user_interest_vector",
            "video_topic_score"
          ]
        }
      },
      {
        "id": "tr_ad_inventory_to_targeting",
        "source": "ad_inventory_feature",
        "target": "ad_targeting_service",
        "properties": {
          "mode": "feature_feed",
          "fields": [
            "inventory_id",
            "supply_quality_score"
          ]
        }
      },
      {
        "id": "tr_ad_targeting_to_billing",
        "source": "ad_targeting_service",
        "target": "billing_settlement_fact",
        "properties": {
          "mode": "write",
          "grain": "campaign_id_day"
        }
      },
      {
        "id": "tr_rec_feedback_to_audit",
        "source": "rec_feedback_topic",
        "target": "audit_event_log",
        "properties": {
          "mode": "stream_sync",
          "payload": "feedback_event"
        }
      },
      {
        "id": "tr_search_ranking_to_audit",
        "source": "search_ranking_service",
        "target": "audit_event_log",
        "properties": {
          "mode": "stream_sync",
          "payload": "ranking_decision_log"
        }
      },
      {
        "id": "tr_audit_to_billing",
        "source": "audit_event_log",
        "target": "billing_settlement_fact",
        "properties": {
          "mode": "batch_sync",
          "grain": "event_id"
        }
      }
    ]
  }
}
